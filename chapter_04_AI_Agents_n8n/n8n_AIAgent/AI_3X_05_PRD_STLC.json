    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\nconst testCases = [];\nconst blocks = output.split(/\\*\\*TestCase \\d+:/g).filter(b => b.trim());\n\nblocks.forEach((block, index) => {\n  const lines = block.split(\"\\n\").filter(l => l.trim());\n  const tc = {\n    \"TestCase ID\": \"\",\n    \"Summary/Title\": \"\",\n    \"Preconditions\": \"\",\n    \"Test Steps\": \"\",\n    \"Expected Result\": \"\",\n    \"Actual Result\": \"\",\n    \"Status\": \"Not Executed\",\n    \"Priority\": \"\",\n    \"Assignee\": \"\",\n    \"Execution Date\": \"\",\n    \"Comments/Notes\": \"\"\n  };\n  \n  let currentField = \"\";\n  \n  lines.forEach(line => {\n    if (line.startsWith(\"TC ID:\")) {\n      tc[\"TestCase ID\"] = line.replace(\"TC ID:\", \"\").trim();\n    } else if (line.startsWith(\"Title:\")) {\n      tc[\"Summary/Title\"] = line.replace(\"Title:\", \"\").trim();\n    } else if (line.startsWith(\"Preconditions:\")) {\n      currentField = \"Preconditions\";\n      tc[\"Preconditions\"] = line.replace(\"Preconditions:\", \"\").trim();\n    } else if (line.startsWith(\"Test Steps:\")) {\n      currentField = \"Test Steps\";\n      tc[\"Test Steps\"] = line.replace(\"Test Steps:\", \"\").trim();\n    } else if (line.startsWith(\"Expected Result:\") || line.startsWith(\"Expected Results:\")) {\n      currentField = \"Expected Result\";\n      tc[\"Expected Result\"] = line.replace(/Expected Results?:/, \"\").trim();\n    } else if (line.startsWith(\"Priority:\")) {\n      tc[\"Priority\"] = line.replace(\"Priority:\", \"\").trim();\n      currentField = \"\";\n    } else if (currentField && line.trim().startsWith(\"-\")) {\n      tc[currentField] += \"\\n\" + line.trim();\n    } else if (currentField && line.trim()) {\n      tc[currentField] += \" \" + line.trim();\n    }\n  });\n  \n  if (tc[\"TestCase ID\"]) {\n    testCases.push(tc);\n  }\n});\n\nreturn testCases.map(tc => ({ json: tc }));"
      },
      "id": "f47cacc7-88f4-48cc-a91a-ccb5e3306c71",
      "name": "Parse Test Cases",
